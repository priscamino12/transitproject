generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminSysteme {
  idAdminSysteme    Int      @id @default(autoincrement())
  nomAdminSysteme   String
  emailAdminSysteme String   @unique
  motDePasse        String
  role              String   @default("SuperAdmin")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("admin_systeme")
}

enum StatusAbonnement {
  ACTIF
  INACTIF
  SUSPENDU
}

model TypeAcces {
  id          Int          @id @default(autoincrement())
  nom         String       @unique // SIMPLE, PREMIUM, ENTERPRISE
  prixBase    Float // prix de base pour 1 mois
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  abonnements Abonnement[]
  entreprises Entreprise[]

  @@map("type_acces")
}

model ModePaiement {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  frais     Float? // exemple : frais fixe ou %
  actif     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  paiements Paiement[]

  @@map("mode_paiement")
}

model DureeAbonnement {
  id          Int          @id @default(autoincrement())
  nom         String // "Mensuel", "Trimestriel", "Annuel"
  nbMois      Int // 1, 3, 12
  reduction   Float // ex: 0.05 = 5%
  abonnements Abonnement[]

  @@map("duree_abonnement")
}

model Abonnement {
  idAbonnement      Int             @id @default(autoincrement())
  typeAccesId       Int
  typeAcces         TypeAcces       @relation(fields: [typeAccesId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dureeAbonnementId Int
  dureeAbonnement   DureeAbonnement @relation(fields: [dureeAbonnementId], references: [id])
  dateDebut         DateTime
  dateFin           DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paiements         Paiement[]

  @@map("abonnement")
}

model Paiement {
  id             Int          @id @default(autoincrement())
  abonnementId   Int
  abonnement     Abonnement   @relation(fields: [abonnementId], references: [idAbonnement], onDelete: Cascade, onUpdate: Cascade)
  entrepriseId   Int
  entreprise     Entreprise   @relation(fields: [entrepriseId], references: [idEntreprise], onDelete: Cascade, onUpdate: Cascade)
  modePaiementId Int
  modePaiement   ModePaiement @relation(fields: [modePaiementId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  montant        Float
  datePaiement   DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("paiement")
}

model Entreprise {
  idEntreprise        Int              @id @default(autoincrement())
  nomEntreprise       String
  logoEntreprise      String? // URL du logo
  adresseEntreprise   String?
  nif                 String           @unique
  statJuridique       String?
  typeAccesId         Int
  typeAcces           TypeAcces        @relation(fields: [typeAccesId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  statusAbonnement    StatusAbonnement @default(ACTIF)
  dateDebutAbonnement DateTime?
  dateFinAbonnement   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  employes            Employe[]
  clients             Client[]
  paiements           Paiement[]

  @@map("entreprise")
}

model Employe {
  idEmploye    Int        @id @default(autoincrement())
  nomEmploye   String
  emailEmploye String     @unique
  motDePasse   String
  role         String     @default("admin") // Enum simulé
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  idEntreprise Int
  entreprise   Entreprise @relation(fields: [idEntreprise], references: [idEntreprise], onDelete: Cascade, onUpdate: Cascade)

  clientCreated      Client[]     @relation("Creator")
  clientModified     Client[]     @relation("Modifier")
  dossierCreated     Dossier[]    @relation("Creator")
  dossierModified    Dossier[]    @relation("Modifier")
  statusCreated      Status[]     @relation("Creator")
  statusModified     Status[]     @relation("Modifier")
  expeditionCreated  Expedition[] @relation("Creator")
  expeditionModified Expedition[] @relation("Modifier")
  produitCreated     Produit[]    @relation("Creator")
  produitModified    Produit[]    @relation("Modifier")
  documentCreated    document[]   @relation("Creator")
  documentModified   document[]   @relation("Modifier")

  @@map("employe")
}

model Client {
  idClient      Int          @id @default(autoincrement())
  nomClient     String
  emailClient   String       @unique
  motDePasse    String?
  role          String       @default("client")
  telClient     String?      @unique
  adresseClient String?
  CINClient     String       @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  idEntreprise  Int
  destinataire  Expedition[] @relation("Destinataire")
  expediteur    Expedition[] @relation("Expediteur")
  entreprise    Entreprise   @relation(fields: [idEntreprise], references: [idEntreprise], onDelete: Cascade, onUpdate: Cascade)
  creerPar      Int
  creator       Employe      @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar   Int?
  modifier      Employe?     @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("client")
}

model Dossier {
  idDossier     Int          @id @default(autoincrement())
  nomDossier    String
  typeTransport String //(aérien, maritime, routier)
  mode          String //(import/export)
  codeDossier   String
  dateOuverture DateTime
  origine       String
  destination   String
  description   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  status        Status[]     @relation("StatusDossier")
  expedtion     Expedition[]
  creerPar      Int
  creator       Employe      @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar   Int?
  modifier      Employe?     @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("dossier")
}

model Status {
  idStatus    Int      @id @default(autoincrement())
  nomStatus   String   @unique
  dateStatus  DateTime
  commentaire String?
  idDossier   Int
  dossiers    Dossier  @relation("StatusDossier", fields: [idDossier], references: [idDossier], onDelete: Cascade, onUpdate: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creerPar    Int
  creator     Employe  @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar Int?
  modifier    Employe? @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("status")
}

model Expedition {
  idExpedition   Int        @id @default(autoincrement())
  idExpediteur   Int
  clientExp      Client     @relation("Expediteur", fields: [idExpediteur], references: [idClient], onDelete: Cascade, onUpdate: Cascade)
  idDestinataire Int
  clientDest     Client     @relation("Destinataire", fields: [idDestinataire], references: [idClient], onDelete: Cascade, onUpdate: Cascade)
  idDossier      Int
  dossier        Dossier    @relation(fields: [idDossier], references: [idDossier], onDelete: Cascade, onUpdate: Cascade)
  produits       Produit[]
  documents      document[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  creerPar       Int
  creator        Employe    @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar    Int?
  modifier       Employe?   @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("expedition")
}

model Produit {
  idProduit    Int        @id @default(autoincrement())
  nomProduit   String
  poid         Float
  volume       Float
  description  String
  idExpedition Int
  expedition   Expedition @relation(fields: [idExpedition], references: [idExpedition], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  creerPar     Int
  creator      Employe    @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar  Int?
  modifier     Employe?   @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("produit")
}

model document {
  idDocument   Int        @id @default(autoincrement())
  nomDocument  String
  typeDocument String //
  urlDocument  String
  idExpedition Int
  expedition   Expedition @relation(fields: [idExpedition], references: [idExpedition], onDelete: Cascade, onUpdate: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  creerPar     Int
  creator      Employe    @relation("Creator", fields: [creerPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)
  modifierPar  Int?
  modifier     Employe?   @relation("Modifier", fields: [modifierPar], references: [idEmploye], onDelete: Cascade, onUpdate: Cascade)

  @@map("document")
}
